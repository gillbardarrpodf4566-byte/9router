# 9Router 服务器 .env 模板
# 使用方法: 复制为 /www/wwwroot/9router/.env 并填写，然后 chmod 600 .env
# 生成随机串的两种方式:
#   Linux 服务器: openssl rand -base64 48
#   Windows 本地: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"

# ===== 必填 =====
# JWT 签名密钥（必须是长随机串）
JWT_SECRET=change-me-to-a-long-random-secret
# 首次登录仪表盘使用的初始密码
INITIAL_PASSWORD=change-me
# 容器内数据目录（compose 已固定，勿改）
DATA_DIR=/app/data

# ===== 运行 =====
PORT=20128
NODE_ENV=production

# ===== 安全 =====
# 端点代理 API Key 加密密钥（也是长随机串）
API_KEY_SECRET=change-me
MACHINE_ID_SALT=change-me
ENABLE_REQUEST_LOGS=false
# 站点走 HTTPS 后建议开启（auth cookie 只会在 https 下发送）
AUTH_COOKIE_SECURE=true
# 要求所有 API 请求携带 API Key 时开启
REQUIRE_API_KEY=false

# ===== 云同步 =====
# 替换为你的域名（https）。NEXT_PUBLIC_* 两个变量在构建时不生效（镜像已构建），
# 主要影响运行时的内部同步回调，保持与你的访问地址一致即可
BASE_URL=https://your-domain.com
NEXT_PUBLIC_BASE_URL=https://your-domain.com
CLOUD_URL=https://9router.com
NEXT_PUBLIC_CLOUD_URL=https://9router.com

# ===== GHCR 拉取凭证（仅当镜像设为私有时需要）=====
# GHCR_USER=your-github-username
# GHCR_TOKEN=github-pat-with-read-packages
